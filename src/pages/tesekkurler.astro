---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Teşekkürler — DÖNGÜ KENT">
<section style="max-width: 820px; margin: 0 auto; padding: 72px var(--g) 120px; display: flex; flex-direction: column; gap: 18px">
<p class="eyebrow">Mesajınız alındı</p>
<h1 class="h2">Teşekkürler, en kısa sürede dönüş yapacağız.</h1>
<p class="lead">Bu arada binanızın karbonunu hesaplayıcıyla tahmin edebilirsiniz.</p>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<a href="/#hesapla" class="btn btn-yesil">Karbon hesapla</a>
<a href="/" class="btn btn-cizgi">Ana sayfa</a>
</div>
</section>
</Layout>
