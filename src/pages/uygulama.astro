---
import Layout from '../layouts/Layout.astro';

// src/mobil/*.html: tasarim/Mobil-*.dc.html dosyalarının gövdesi (tasarım aracı etiketleri ayıklanmış).
const dosyalar = import.meta.glob<string>('../mobil/*.html', { query: '?raw', import: 'default', eager: true });

const basliklar: Record<string, string> = {
  Baslangic: 'Başlangıç rehberi',
  Bina: 'Binam',
  Katki: 'İklim katkısı',
  Pasaport: 'Karbon pasaportu',
  Cuzdan: 'Karbon cüzdanı',
  Satis: 'Satış onayı',
  Rehber: 'Nasıl hesaplanır',
};

const ekranlar = Object.entries(dosyalar)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([yol, html]) => {
    const ad = yol.match(/\d+-(\w+)\.html$/)![1];
    return { ad: basliklar[ad] ?? ad, html };
  });
---
<Layout title="Uygulama — KARGI-GÖLGE" description="KARGI-GÖLGE mobil uygulamasının ekranları: binam, karbon pasaportu, cüzdan, satış onayı ve iklim katkısı.">
<section style="max-width: 1240px; margin: 0 auto; padding: 48px var(--g) 88px; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-direction: column; gap: 12px; max-width: 820px">
<p class="eyebrow">Mobil uygulama · tanıtım</p>
<h1 class="h2">Gölgeliğin, tasarrufun ve karbonun cebinde</h1>
<p class="lead">Lamelleri ayarla, kontrol dairesine göre tasarrufunu izle, panelinin karbon pasaportunu gör ve doğrulanan tonlarını Emlak Konut'a sat. Uygulama geliştirme aşamasında; aşağıdakiler tasarım ekranlarıdır, veriler örnektir.</p>
</div>
<div class="ekranlar">
{ekranlar.map((e) => (
<figure class="ekran">
<div class="telefon">
<div class="cerceve" inert set:html={e.html} />
</div>
<figcaption>{e.ad}</figcaption>
</figure>
))}
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<a href="/iletisim?konu=uygulama" class="btn btn-yesil">Çıkınca haber ver</a>
<a href="/#uygulama" class="btn btn-cizgi">Kullanım adımları</a>
</div>
</section>
</Layout>

<style>
.ekranlar { display: grid; grid-template-columns: repeat(auto-fill, minmax(332px, 1fr)); gap: 40px 24px; justify-items: center; }
.ekran { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 14px; }
.ekran figcaption { font-size: 15px; font-weight: 600; }
/* 390 × 844 tasarım ekranı; telefon çerçevesi içinde ölçeklenir */
.telefon { zoom: 0.8; padding: 14px; background: #1E2A24; border-radius: 58px; box-shadow: 0 18px 48px rgba(30, 42, 36, 0.22); }
.cerceve { width: 390px; height: 844px; border-radius: 44px; overflow: hidden; background: #F6F1E7; }
@media (max-width: 420px) {
  .ekranlar { grid-template-columns: 1fr; }
  .telefon { zoom: 0.74; }
}
@media (max-width: 360px) {
  .telefon { zoom: 0.68; }
}
</style>
